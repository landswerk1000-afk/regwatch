#!/bin/bash
# Запуск агента из любой папки: сам находит проект и подхватывает ~/.regwatch.env
#   ~/Desktop/Code/"Агент по инвестициям"/regwatch-cli doctor
# Удобнее — один раз добавить псевдоним (см. README).
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
[ -f "$HOME/.regwatch.env" ] && { set -a; . "$HOME/.regwatch.env"; set +a; }
cd "$HERE" || exit 1
exec /usr/bin/python3 -m regwatch "$@"
