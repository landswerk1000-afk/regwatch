# Настройки агента-монитора. Читается при каждом запуске.
# Права: chmod 600 — файл доступен только вам.
#
# Правило одно: значение пишется сразу после знака "=", без пробелов.
# Комментарии — только на отдельных строках.


# ============ 1. ПОЧТА (обязательно) ============
# Без этого отчёты не придут.
# Для Gmail нужен ПАРОЛЬ ПРИЛОЖЕНИЯ, не обычный пароль от почты:
# аккаунт Google -> Безопасность -> Двухэтапная аутентификация -> Пароли приложений
REGWATCH_SMTP_PASSWORD=


# ============ 2. ГОСДУМА: официальное API (рекомендуется) ============
# Работает НАПРЯМУЮ, без прокси и туннеля.
# Оба ключа бесплатные, выдаются по форме: http://api.duma.gov.ru/key-request
# APP-ключ обязателен: агент — серверное приложение, а не сайт.
DUMA_API_TOKEN=
DUMA_APP_TOKEN=


# ============ 3. ПРОКСИ для regulation.gov.ru (необязательно) ============
# Нужен только для проектов приказов министерств. Госдума работает без него.
#
# ОСТАВЬТЕ ПУСТЫМ — тогда агент сам подхватит рабочий прокси из кэша
# (кэш наполняет команда: python3 -m regwatch proxies).
# Заполните ТОЛЬКО если хотите задать прокси вручную — это отключит автоподбор.
# Примеры: socks5h://127.0.0.1:1080   или   http://user:pass@host:3128
REGWATCH_PROXY=


# ============ 4. ТУННЕЛЬ до своей машины в России (необязательно) ============
# Постоянная замена бесплатным прокси: у домашнего компьютера IP не протухает.
# Заполните три строки и запустите ./tunnel.sh
# Адрес: внешний IP, домен или имя машины в Tailscale (вида 100.x.x.x)
RU_SSH_HOST=
RU_SSH_USER=
RU_SSH_PORT=22
TUNNEL_PORT=1080
